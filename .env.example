# =============================================================================
# PotatoClaw — Environment Configuration
# Copy this file to .env and fill in your values.
# All secrets can also be managed via Mission Control UI → Secrets page.
# =============================================================================

# -----------------------------------------------------------------------------
# AI PROVIDER — choose Anthropic directly OR OpenRouter
# -----------------------------------------------------------------------------

# Option A: Anthropic directly
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Option B: OpenRouter (routes to any model — Gemini, GPT-4, etc.)
# Get from https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=sk-or-...    # same as OPENROUTER_API_KEY
# ANTHROPIC_API_KEY=                # must be explicitly empty
# ANTHROPIC_DEFAULT_SONNET_MODEL=google/gemini-3-flash-preview
# ANTHROPIC_DEFAULT_OPUS_MODEL=google/gemini-3-pro-preview
# ANTHROPIC_DEFAULT_HAIKU_MODEL=google/gemini-2.5-flash-lite
# CLAUDE_CODE_SUBAGENT_MODEL=google/gemini-3-flash

# -----------------------------------------------------------------------------
# OPTIONAL — AI Integrations
# -----------------------------------------------------------------------------

# Composio API key — 500+ app integrations (Gmail, GitHub, Notion, etc.)
# Get from https://app.composio.dev/
COMPOSIO_API_KEY=

# -----------------------------------------------------------------------------
# MESSAGING ADAPTERS
# Enable each adapter by providing its credentials.
# Leave blank to disable.
# -----------------------------------------------------------------------------

# Slack — Primary work platform
# SLACK_BOT_TOKEN  : xoxb-... token from https://api.slack.com/apps → OAuth & Permissions
# SLACK_APP_TOKEN  : xapp-... token — required for Socket Mode (App-Level Tokens)
# SLACK_SIGNING_SECRET : signing secret from Basic Information page
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_SIGNING_SECRET=

# Telegram — Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Discord — Get from https://discord.com/developers/applications → Bot → Token
DISCORD_BOT_TOKEN=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------

# Mission Control login credentials (HTTP Basic Auth)
# Default: admin / admin
UI_USERNAME=admin
UI_PASSWORD=admin

# -----------------------------------------------------------------------------
# SYSTEM
# -----------------------------------------------------------------------------

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Data directory — where all persistent data is stored.
# In Docker this is mounted at /data. For local dev it falls back to ~/.potatoclaw
DATA_DIR=/data

# Gateway HTTP port — health check endpoint and WhatsApp QR display
GATEWAY_PORT=4400

# Mission Control UI port — REST API + SSE + web dashboard
UI_PORT=4401
